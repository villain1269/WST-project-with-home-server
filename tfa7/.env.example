APP_NAME="TFA7 Laravel POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# ============================================================
# Replace your-host.ts.net with your real Tailscale Funnel
# hostname. NO trailing slash after the prefix.
#
# Local development (php artisan serve without Caddy):
#   APP_URL=http://127.0.0.1:8003
#   ASSET_URL=http://127.0.0.1:8003
#   SESSION_PATH=/
# ============================================================
APP_URL=https://christian-ubuntu.tail8fce48.ts.net/tfa7
ASSET_URL=https://christian-ubuntu.tail8fce48.ts.net/tfa7

LOG_CHANNEL=stderr
LOG_LEVEL=warning

SESSION_DRIVER=file
SESSION_PATH=/tfa7
SESSION_COOKIE=tfa7_session
SESSION_DOMAIN=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=schoolproj_tfa7
DB_USERNAME=laravel_user
DB_PASSWORD=

FILESYSTEM_DISK=local
