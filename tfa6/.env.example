APP_NAME="TFA6 Laravel POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# ============================================================
# Replace your-host.ts.net with your real Tailscale Funnel
# hostname. NO trailing slash after the prefix.
#
# Local development (php artisan serve without Caddy):
#   APP_URL=http://127.0.0.1:8002
#   ASSET_URL=http://127.0.0.1:8002
#   SESSION_PATH=/
# ============================================================
APP_URL=https://christian-ubuntu.tail8fce48.ts.net/tfa6
ASSET_URL=https://christian-ubuntu.tail8fce48.ts.net/tfa6

LOG_CHANNEL=stderr
LOG_LEVEL=warning

SESSION_DRIVER=file
SESSION_PATH=/tfa6
SESSION_COOKIE=tfa6_session
SESSION_DOMAIN=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=schoolproj_tfa6
DB_USERNAME=laravel_user
DB_PASSWORD=
