APP_NAME="TSA3 Tasks for Today"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# ============================================================
# Replace your-host.ts.net with your real Tailscale Funnel
# hostname. NO trailing slash after the prefix.
#
# Local development (php artisan serve without Caddy):
#   APP_URL=http://127.0.0.1:8004
#   ASSET_URL=http://127.0.0.1:8004
#   SESSION_PATH=/
# ============================================================
APP_URL=https://christian-ubuntu.tail8fce48.ts.net/tsa3
ASSET_URL=https://christian-ubuntu.tail8fce48.ts.net/tsa3

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Manila time so "today's tasks" matches the student's calendar day
# (affects now(), the seeder, and the whereDate query alike).
APP_TIMEZONE=Asia/Manila

SESSION_DRIVER=file
SESSION_PATH=/tsa3
SESSION_COOKIE=tsa3_session
SESSION_DOMAIN=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=schoolproj_tsa3
DB_USERNAME=laravel_user
DB_PASSWORD=
