APP_NAME="TFA5 Laravel POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# ============================================================
# IMPORTANT — replace your-host.ts.net with your real Tailscale
# Funnel hostname. NO trailing slash after the prefix.
#
# Local development (php artisan serve without Caddy) uses:
#   APP_URL=http://127.0.0.1:8001
#   ASSET_URL=http://127.0.0.1:8001
#   SESSION_PATH=/
# ============================================================
APP_URL=https://christian-ubuntu.tail8fce48.ts.net/tfa5
ASSET_URL=https://christian-ubuntu.tail8fce48.ts.net/tfa5

LOG_CHANNEL=stderr
LOG_LEVEL=warning

SESSION_DRIVER=file
# Scope this app's cookies to its path prefix so cookies never leak
# between projects served on the same hostname.
SESSION_PATH=/tfa5
SESSION_COOKIE=tfa5_session
SESSION_DOMAIN=

# TFA5 uses static PHP arrays — no database needed.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=schoolproj_tfa5
DB_USERNAME=laravel_user
DB_PASSWORD=
